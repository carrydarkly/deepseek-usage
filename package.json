{
  "name": "deepseek-usage",
  "version": "0.2.0",
  "description": "在 DSH Web GUI 输入框下方那一排显示 DeepSeek API 账户余额/剩余额度的插件（当前仅支持 DeepSeek API）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "balance",
    "usage",
    "quota"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carrydarkly/deepseek-usage.git"
  },
  "homepage": "https://github.com/carrydarkly/deepseek-usage#readme",
  "bugs": {
    "url": "https://github.com/carrydarkly/deepseek-usage/issues"
  },
  "license": "MIT"
}
